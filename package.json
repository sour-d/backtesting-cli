{
  "name": "quantlab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "quantlab": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "setup": "mkdir -p .data/market .data/technical .data/results .data/transformedResult .data/resultsStats",
    "clean": "rm -rf dist .data/*/*",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "bybit-api": "^4.1.0",
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.7",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
