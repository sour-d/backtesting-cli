{
  "name": "quantlab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "quantlab": "./dist/cli/index.js"
  },
  "scripts": {
    "dev:live": "tsx src/cli/index.ts live",
    "dev:backtest": "tsx src/cli/index.ts backtest",
    "download:market": "node dist/cli/index.js download-market",
    "dev:download:market": "tsx src/cli/index.ts download-market",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "mkdir -p .data/market .data/trades .data/backtest/logs .data/technical .data/results .data/transformedResult .data/resultsStats",
    "start:live": "node dist/cli/index.js live",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .data/*/*",
    "typecheck": "tsc --noEmit",
    "compare:trades": "tsx scripts/compareBacktestTradeResults.ts",
    "insights:trades": "tsx scripts/tradeInsights.ts",
    "insights:live-api": "tsx scripts/liveApiInsights.ts",
    "insights:all": "tsx scripts/tradeInsights.ts --all-symbols",
    "list:trades": "tsx scripts/listCompletedTrades.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "bybit-api": "^4.1.0",
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.7",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
