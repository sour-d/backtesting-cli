# Server port (Render.com sets this automatically)
PORT=3000

# Public URL of this app (e.g. https://your-app.onrender.com). When set, the app pings itself
# every 1 min at /api/ping to prevent Render free tier from spinning down.
LIVE_URL=https://your-app.onrender.com

# Supabase — when set, live mode uses DB persistence instead of file storage.
# Leave empty or remove to fall back to FileStore (.data/ directory).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Bybit API (for LiveBroker / LiveFeed)
BYBIT_API_KEY=your-api-key
BYBIT_API_SECRET=your-api-secret
